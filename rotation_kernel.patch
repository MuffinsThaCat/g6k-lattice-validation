+void Siever::set_rotation(const long* M, unsigned int order, double clone_below)
+{
+    rot_clones_added = 0;
+    rot_order = 0;
+    rot_M.clear();
+    if (order == 0 || M == nullptr) return;
+    rot_M.assign(M, M + static_cast<size_t>(n) * n);
+    rot_clone_below = clone_below;
+    rot_order = order;
+}
+
+// Append the rotation images x*M^k (k = 1..rot_order-1) of `src` to transaction_db. They have the same
+// length as `src`, so they are exactly as good as `src` for the database. Duplicates are rejected by
+// the uid hash table like any other new entry.
+void Siever::bgj1_add_rotation_clones(Entry const &src, std::vector<Entry>& transaction_db)
+{
+    std::array<int64_t, MAX_SIEVING_DIM> cur, nxt;
+    for (unsigned int i = 0; i < n; ++i) cur[i] = src.x[i];
+    for (unsigned int k = 1; k < rot_order; ++k)
+    {
+        for (unsigned int j = 0; j < n; ++j)
+        {
+            int64_t acc = 0;
+            for (unsigned int i = 0; i < n; ++i) acc += cur[i] * rot_M[static_cast<size_t>(i) * n + j];
+            if (acc > std::numeric_limits<ZT>::max() || acc < std::numeric_limits<ZT>::min()) return;
+            nxt[j] = acc;
+        }
+        cur = nxt;
+        Entry e;
+        e.x = src.x;
+        for (unsigned int j = 0; j < n; ++j) e.x[j] = static_cast<ZT>(cur[j]);
+        recompute_data_for_entry<Recompute::recompute_all_and_consider_otf_lift>(e);
+        if (!uid_hash_table.insert_uid(e.uid)) continue;
+        transaction_db.push_back(e);
+        ++rot_clones_added;
+    }
+}
